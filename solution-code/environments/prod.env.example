# prod — tightest gates: lower initial canary weight, longest pauses,
# promotion requires a GitHub Environment manual-approval reviewer in
# addition to the automated quality gate (see
# .github/workflows/ci-cd-quality-gate.yml's `promote-staging-to-prod`
# job, which runs under the `prod` GitHub Environment).
SAKH_ENVIRONMENT=prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.sakh-prod.svc.cluster.local:4317
SAKH_EVAL_SAMPLE_RATE=0.3
SAKH_DRIFT_BASELINE_SIZE=30
SAKH_DRIFT_WINDOW=50
SAKH_DRIFT_THRESHOLD=0.08
SAKH_TOOL_MIX_THRESHOLD=0.35
