# dev — loosest gates: single-replica, short rollout pauses, used for
# the shadow-eval-batch CI job. Promote dev -> staging only after the
# quality gate says "promote" (see .github/workflows/ci-cd-quality-gate.yml).
SAKH_ENVIRONMENT=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SAKH_EVAL_SAMPLE_RATE=0.5
SAKH_DRIFT_BASELINE_SIZE=8
SAKH_DRIFT_WINDOW=15
SAKH_DRIFT_THRESHOLD=0.08
SAKH_TOOL_MIX_THRESHOLD=0.35
