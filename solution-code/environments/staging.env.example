# staging — same code, real canary traffic split (10%), longer rollout
# pauses than dev so the quality gate sees a realistic sample size
# before promotion to prod is even attempted.
SAKH_ENVIRONMENT=staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.sakh-staging.svc.cluster.local:4317
SAKH_EVAL_SAMPLE_RATE=0.5
SAKH_DRIFT_BASELINE_SIZE=15
SAKH_DRIFT_WINDOW=30
SAKH_DRIFT_THRESHOLD=0.08
SAKH_TOOL_MIX_THRESHOLD=0.35
